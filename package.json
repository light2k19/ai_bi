{
  "name": "ai-bi",
  "private": true,
  "version": "0.1.0",
  "description": "AI-driven BI: multi-project analysis pages generated by AI, powered by live read-only data through skills",
  "type": "module",
  "workspaces": [
    "packages/*",
    "skills/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "node tools/dev.mjs",
    "dev:server": "npm run dev -w @aibi/server",
    "dev:web": "npm run dev -w @aibi/web",
    "dev:runtime": "npm run dev -w @aibi/runtime",
    "build": "npm run build -w @aibi/runtime && npm run build -w @aibi/web",
    "start": "npm run start -w @aibi/server",
    "seed": "npm run seed -w @aibi/server",
    "backup": "node tools/backup.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p apps/web/tsconfig.json --noEmit && tsc -p apps/runtime/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:connectors": "vitest run --config vitest.connectors.config.ts",
    "test:e2e": "node tools/e2e-ui.mjs"
  },
  "dependencies": {
    "tsx": "^4.19.2"
  },
  "devDependencies": {
    "@types/mssql": "^9.1.11",
    "@types/node": "^22.10.0",
    "@types/oracledb": "^6.10.4",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=22.13"
  }
}
