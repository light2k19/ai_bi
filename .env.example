# Copy to .env and fill in. Never commit .env.

# ── AI provider (any OpenAI-compatible chat completions API) ──
# OpenRouter
AI_BASE_URL=https://openrouter.ai/api
AI_API_KEY=sk-or-v1-...
AI_MODEL=google/gemini-2.5-flash
AI_MODEL_FAST=google/gemini-2.5-flash
# Local models, for example:
#   Ollama:    AI_BASE_URL=http://localhost:11434   AI_MODEL=qwen2.5:14b     AI_API_KEY=
#   LM Studio: AI_BASE_URL=http://localhost:1234/v1 AI_MODEL=<loaded model>  AI_API_KEY=
#   vLLM:      AI_BASE_URL=http://localhost:8000/v1 AI_MODEL=<served model>
# Models without function calling: AI_TOOL_MODE=json
AI_TOOL_MODE=native
# AI_MAX_TOKENS=16000
# AI_TEMPERATURE=0.2

# ── Server ──
PORT=8787
HOST=127.0.0.1
# Secret for encrypting data-source credentials and signing tokens (default: generated into data/.secret)
# AIBI_SECRET=change-me-to-a-long-random-string
# AIBI_DATA_DIR=data

# Public origins (dev defaults shown). The page runtime MUST be on a different origin than the web app.
AIBI_WEB_ORIGIN=http://localhost:5173
AIBI_RUNTIME_ORIGIN=http://localhost:5174
AIBI_PUBLIC_API_URL=http://localhost:8787
# Docker / production: the platform and the runtime as users reach them, e.g.
#   AIBI_WEB_ORIGIN=http://localhost:8787  AIBI_PUBLIC_API_URL=http://localhost:8787  AIBI_RUNTIME_ORIGIN=http://localhost:8788
#   (or the public https URLs behind a reverse proxy; the two must be different origins)
# Production: serve the built runtime from this server on a second port (its own origin)
# RUNTIME_PORT=8788
# AIBI_SECURE_COOKIES=1

# Query limits (projects can lower them)
# AIBI_MAX_ROWS=10000
# AIBI_QUERY_TIMEOUT_MS=30000
# AIBI_QUERIES_PER_MINUTE=600
# AIBI_AI_PER_MINUTE=30
# AIBI_LOGINS_PER_MINUTE=30        # sign-in attempts per minute per client address (each account: 10)

# Hosts page modules may be loaded from
# AIBI_MODULE_HOSTS=esm.sh,cdn.jsdelivr.net,unpkg.com

# Headless browser for PDF export (Edge/Chrome are found automatically on Windows)
# AIBI_BROWSER_PATH=/usr/bin/chromium
